# Keep the build context small: without this, every build ships the whole ioq3
# submodule and node_modules to the daemon before a single instruction runs.
#
# Anything produced BY the build must be listed here, or a stale local copy
# silently becomes a build input.

# --- VCS / editor ---
.git
.gitignore
.gitmodules
.github
*.swp
.DS_Store
.idea/
.vscode/

# --- dependencies (installed inside the build) ---
node_modules/

# --- build outputs ---
build/
hf/build/
assets/
assets_src/
base/**/*.pk3
base/hf/games.log
base/hf/q3config_server.cfg
html/hf/shenanigans/

# --- ioq3 ---
#
# The whole submodule is copied into the build (see CONTAINERS.md), so exclude
# only what must not come along. node_modules is the critical one: quake-build
# installs ws@0.4.29 into /opt/ioq3/node_modules before copying the tree, and
# the copy merges into that directory.
ioq3/build/
ioq3/node_modules/
ioq3/.git

# --- compose and docs are never build inputs ---
compose.yml
compose.dev.yml
README.md
CONTAINERS.md
.mocharc.json
